                </div>
                <div class="mt-6 flex flex-wrap justify-center gap-4 text-sm text-gray-600">
                    <span><i class="fas fa-check-circle text-primary mr-1"></i> Only shortlisted candidates will be contacted</span>
                    <span><i class="fas fa-check-circle text-primary mr-1"></i> CVs should be in PDF or Word format</span>
                    <span><i class="fas fa-check-circle text-primary mr-1"></i> Accommodation available for most positions</span>
                </div>
            </div>
        </div>
    </section>

    <Footer slot="footer" />

    <script>
        // Job card toggle functionality
        document.addEventListener('DOMContentLoaded', () => {
            const jobCards = document.querySelectorAll('.job-card');
            const filterBtns = document.querySelectorAll('.filter-btn');
            const noResults = document.getElementById('no-results');

            // Toggle job details
            jobCards.forEach(card => {
                const indicator = card.querySelector('.toggle-indicator');
                const details = card.querySelector('.job-details');
                
                card.addEventListener('click', (e) => {
                    // Don't toggle if clicking on a link
                    if (e.target.closest('a')) return;
                    
                    const isOpen = details.classList.contains('open');
                    
                    // Close all other job details
                    document.querySelectorAll('.job-details.open').forEach(d => {
                        if (d !== details) {
                            d.classList.remove('open');
                            d.closest('.job-card').classList.remove('active');
                            const otherIndicator = d.closest('.job-card').querySelector('.toggle-indicator');
                            if (otherIndicator) {
                                otherIndicator.innerHTML = '<i class="fas fa-chevron-down"></i>';
                            }
                        }
                    });
                    
                    // Toggle current
                    if (isOpen) {
                        details.classList.remove('open');
                        card.classList.remove('active');
                        indicator.innerHTML = '<i class="fas fa-chevron-down"></i>';
                    } else {
                        details.classList.add('open');
                        card.classList.add('active');
                        indicator.innerHTML = '<i class="fas fa-chevron-up"></i>';
                    }
                });
            });

            // Filter functionality
            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Update active button
                    filterBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    
                    const filter = btn.dataset.filter;
                    let visibleCount = 0;
                    
                    jobCards.forEach(card => {
                        const location = card.dataset.location;
                        if (filter === 'all' || location === filter) {
                            card.style.display = '';
                            visibleCount++;
                        } else {
                            card.style.display = 'none';
                        }
                    });
                    
                    // Show/hide no results message
                    if (visibleCount === 0) {
                        noResults.classList.remove('hidden');
                    } else {
                        noResults.classList.add('hidden');
                    }
                });
            });
        });
    </script>
</Layout>